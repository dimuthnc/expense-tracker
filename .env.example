# Copy to .env.local (gitignored) and fill in from the Auth0 dashboard.
# Application -> Settings: Domain + Client ID
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
# APIs -> your API -> Identifier (audience)
VITE_AUTH0_AUDIENCE=https://api.expense.dimuthmenikgama.com
